# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - BACKEND / SUPABASE
# Copie este arquivo para .env e preencha com as credenciais do seu projeto Supabase.
# ATENÇÃO: NUNCA versione o arquivo .env com credenciais reais!
# ==============================================================================

# URL base da API do projeto Supabase (disponível em Project Settings > API)
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública anônima (anon key) - usada pelo frontend e pelo firmware do robô
# Possui permissões restritas controladas por Row Level Security (RLS)
SUPABASE_ANON_KEY=sua-chave-publica-anon-aqui
