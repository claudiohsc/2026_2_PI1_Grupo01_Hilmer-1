# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - FRONTEND
# Copie este arquivo para .env.local e preencha com os dados do projeto Supabase
# (Project Settings > API). O .env.local está no .gitignore: nunca o versione.
#
# Só o Vite lê estas variáveis, e só as que começam com VITE_ chegam ao navegador.
# Por isso aqui entra apenas a chave pública (anon), que só tem permissão de leitura
# (Row Level Security). A chave service_role NUNCA deve ser colocada no frontend.
# ==============================================================================

# URL base da API do projeto Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública anônima (anon key)
VITE_SUPABASE_ANON_KEY=sua-chave-publica-anon-aqui
