{
  "name": "micromouse-dashboard",
  "private": true,
  "version": "0.1.0",
  "description": "Dashboard web do micromouse: telemetria ao vivo e histórico de corridas (HU-14).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cobertura": "vitest run --coverage"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.5"
  }
}
